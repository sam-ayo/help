{
  "name": "help-relay",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:pwa && wrangler dev",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "vapid": "node scripts/vapid.ts",
    "test": "node --test test/push.test.ts test/relay.test.ts",
    "deploy": "npm run build:pwa && wrangler deploy",
    "build:pwa": "pnpm --dir ../pwa install --frozen-lockfile && pnpm --dir ../pwa build",
    "pretest": "npm run build:pwa"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "wrangler": "4.154.0"
  }
}
